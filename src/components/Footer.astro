---
import { SITE } from '@/consts'
import { url } from '@/lib/url'
const repeat = 12
---
<footer class="site-footer">
  <div class="footer-mark">
    <span>{SITE.footer.mark}</span>
    <strong>{SITE.footer.submark}</strong>
  </div>
  <div class="footer-cluster">
    <nav class="footer-nav" aria-label="Footer navigation">
      {SITE.footer.nav.map((item) => (
        <a href={url(item.href)}>{item.label}</a>
      ))}
    </nav>
    <div class="footer-meta">
      {SITE.footer.items.map((item) => <span>{item}</span>)}
      {SITE.footer.icp && (
        <a
          class="footer-icp"
          href={SITE.footer.icp.href}
          target="_blank"
          rel="noopener noreferrer"
        >{SITE.footer.icp.label}</a>
      )}
    </div>
  </div>
</footer>

<div class="footer-marquee-bg" aria-hidden="true">
  <div class="marquee-track">
    {Array.from({ length: repeat }).map(() => (
      <span class="marquee-spacer">{SITE.footer.marqueeText}</span>
    ))}
  </div>
</div>

<style>
  .footer-marquee-bg .marquee-track {
    display: flex;
    flex-shrink: 0;
    animation: marqueeScroll 32s linear infinite;
    will-change: transform;
  }

  @keyframes marqueeScroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
</style>
