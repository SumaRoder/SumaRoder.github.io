---
import PageShell from '@/layouts/PageShell.astro'
import SectionKicker from '@/components/SectionKicker.astro'
import PostCard from '@/components/PostCard.astro'
import Comments from '@/components/Comments.astro'
import { SITE } from '@/consts'
import { getPublishedPosts, postReadingTime, findRelatedPosts, type Post } from '@/lib/posts'
import { url } from '@/lib/url'
import { render } from 'astro:content'

export async function getStaticPaths() {
  const posts = await getPublishedPosts()
  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      index,
      previous: index > 0 ? posts[index - 1] : undefined,
      next: index < posts.length - 1 ? posts[index + 1] : undefined,
      related: findRelatedPosts(post, posts),
    },
  }))
}

interface Props {
  post: Post
  index: number
  previous?: Post
  next?: Post
  related: Post[]
}

const { post, index, previous, next, related } = Astro.props
const data = post.data
const { Content } = await render(post)
const reading = postReadingTime(post)

const siteOrigin = Astro.site ?? new URL('https://example.com')
const canonical = new URL(Astro.url.pathname, siteOrigin).href
const ogImageUrl = data.cover
  ? new URL(url(data.cover), siteOrigin).href
  : undefined

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.excerpt,
  datePublished: data.date,
  inLanguage: SITE.lang,
  mainEntityOfPage: canonical,
  url: canonical,
  keywords: data.tags.join(', '),
  articleSection: data.category,
  ...(ogImageUrl ? { image: ogImageUrl } : {}),
  author: { '@type': 'Person', name: SITE.brand.name },
  publisher: { '@type': 'Organization', name: SITE.brand.name },
}
---
<PageShell
  title={`${data.title} · ${SITE.brand.name}`}
  description={data.excerpt}
  image={data.cover}
  type="article"
  publishedTime={data.date}
  tags={data.tags}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <main>
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={url('/')}>首页</a>
      <span aria-hidden="true">/</span>
      <a href={url('/posts')}>文章</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{data.title}</span>
    </nav>

    <section class={`detail-hero${data.cover ? '' : ' no-cover'}`}>
      {data.cover && (
        <div class="detail-cover">
          <img src={url(data.cover)} alt={data.title} />
        </div>
      )}
      <div class="detail-copy">
        <SectionKicker index={String(index + 1).padStart(2, '0')} label={data.subtitle} />
        <h1>{data.title}</h1>
        <p>{data.excerpt}</p>
        <div class="detail-meta">
          <span>{data.category}</span>
          <span>{data.date}</span>
          {reading && <span>{reading}</span>}
        </div>
      </div>
    </section>

    <section class="article-shell">
      <aside class="article-aside">
        <strong>TAG TRACE</strong>
        {data.tags.map((tag) => (
          <a href={url(`/tags/${encodeURIComponent(tag)}`)}>#{tag}</a>
        ))}
      </aside>
      <article class="article-body">
        <Content />
      </article>
    </section>

    <section class="article-license" aria-label="License statement">
      <p>
        {SITE.license.intro}
        <a href={SITE.license.url} target="_blank" rel="noreferrer">{SITE.license.label}</a>
        许可协议。
      </p>
    </section>

    {related.length > 0 && (
      <section class="related-posts" aria-label="Related posts">
        <SectionKicker index="REL" label="RELATED READING" />
        <h2>相关文章</h2>
        <div class="related-grid">
          {related.map((p, i) => <PostCard post={p} index={i} compact />)}
        </div>
      </section>
    )}

    <nav class="article-nav" aria-label="Post navigation">
      {previous ? (
        <a href={url(`/posts/${previous.id}`)}>
          <span>上一篇</span>
          <strong>{previous.data.title}</strong>
        </a>
      ) : <span />}
      {next ? (
        <a href={url(`/posts/${next.id}`)}>
          <span>下一篇</span>
          <strong>{next.data.title}</strong>
        </a>
      ) : <span />}
    </nav>

    <Comments />
  </main>
</PageShell>

<script>
  import { bootPostEnhancers } from '@/lib/scripts/post-enhancers'
  bootPostEnhancers()
</script>
